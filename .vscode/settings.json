{
  "python.terminal.activateEnvironment": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.venv/*/**": true
  },
  "cSpell.words": [
    "backref",
    "BUCHA",
    "demining",
    "dotenv",
    "Dron",
    "fastapi",
    "flowbite",
    "HTMX",
    "ilike",
    "jsonify",
    "msgid",
    "msgstr",
    "nplurals",
    "onchange",
    "onupdate",
    "pydantic",
    "pyproject",
    "pytest",
    "signalbot",
    "sqlalchemy",
    "svarog",
    "tailwindcss",
    "UAFSans",
    "werkzeug",
    "wsgi",
    "wtforms",
    "Клікніть",
    "скіли"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "cSpell.language": "en,uk",
  "djlint.showInstallError": false,
  "html.format.wrapLineLength": 1024
}
