# Put environment variables that hold sensitive data such as passwords here.
# NOTE: This file will not be placed under version control.

APP_NAME=Svarog site
SECRET_KEY=set_here_secret

# Database
# Database details for postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=passwd
POSTGRES_DB=db
LOCAL_DB_PORT=15432

# Database URL to use in develop configuration
ALCHEMICAL_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${LOCAL_DB_PORT}/${POSTGRES_DB}

# WEB app
LOCAL_WEB_PORT=8001

# API app
LOCAL_API_PORT=8002

# e-mail configuration
MAIL_USERNAME=admin@simple2b.com
MAIL_DEFAULT_SENDER=admin@simple2b.com
MAIL_PASSWORD="super secret"

MAIL_SERVER=mail.simple2b.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=user_name
MAIL_PASSWORD=set_password
MAIL_DEFAULT_SENDER=user@simple2b.com

# Super admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=simple2b.info@gmail.com
ADMIN_PASSWORD=admin

# Pagination
DEFAULT_PAGE_SIZE=8
PAGE_LINKS_NUMBER=8

# API
JWT_SECRET=secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440


PARKING = False

SIGNAL_HOST=127.0.0.1 # Must be a valid IP address or hostname without protocol
SIGNAL_PORT=8080
SIGNAL_FROM="+380631234567" # Must be a valid phone number registered in signal
SIGNAL_TO="+380977654321" # Must be an array

# Custom links
LINK_INSTAGRAM=https://www.instagram.com/424_svarog/
LINK_FACEBOOK=https://www.facebook.com/svarog.usf
LINK_TELEGRAM=https://t.me/svarog_usf
LINK_YOUTUBE=https://www.youtube.com/@424SVAROG
LINK_DONATE=https://send.monobank.ua/jar/3LiMyQb9G2
LINK_TEST_DRIVE=https://docs.google.com/forms/d/1GzpWBUZbNhZffrV65M3xP05LMXJUTp_AepSTK8i7wlw
LINK_COFFEE_BOX=https://www.instagram.com/424_svarog/
